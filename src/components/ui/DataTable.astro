---
// Tabelle aus Spaltenköpfen und Zeilen.
//
// Die erste Zelle jeder Zeile wird zum <th scope="row">: In beiden Tabellen
// dieser Seite ist das die Strecke, und sie beschriftet die Zeile. Ohne das
// liest ein Screenreader in Zeile fünf nur „4, 09:00, 25 €" vor.
//
// Umschlossen von einem scrollbaren Rahmen — auf 390 px passt keine
// vierspaltige Tabelle, und die Seite selbst darf dabei nicht wandern.

export type Cell = string | number;

interface Props {
  columns: string[];
  rows: Cell[][];
  caption?: string;
}

const { columns, rows, caption } = Astro.props;
---

<div class="table-scroll">
  <table class="table">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {columns.map((col) => <th scope="col">{col}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map(([erste, ...rest]) => (
          <tr>
            <th scope="row">{erste}</th>
            {rest.map((zelle) => (
              <td>{zelle}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .table caption {
    margin-bottom: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-align: left;
  }

  .table th,
  .table td {
    padding: 0.7rem 0.9rem 0.7rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }

  .table thead th {
    color: var(--ink-faint);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Die Streckenbezeichnung ist die Information, nach der gesucht wird —
     sie bekommt Gewicht, der Rest ordnet sich unter. */
  .table tbody th {
    font-size: var(--step-1);
    font-weight: 700;
    white-space: normal;
  }

  .table tbody tr:last-child th,
  .table tbody tr:last-child td {
    border-bottom: 0;
  }

  /* Auf dem Handy bricht die Tabelle um, statt seitwärts zu laufen.
     Vierspaltig kam sie auf der Startseite auf rund 470 px und musste
     geschoben werden — bei einer Preistabelle heißt das, dass der Preis nicht
     im Bild ist, während man die Strecke liest.
     Die Breite bestimmen zwei unteilbare Wörter, „Flossenschwimmen" und
     „Meldegebühr". Mit Silbentrennung (`lang="de"` steht in Base.astro) darf
     der Browser sie brechen und die Tabelle passt.
     Nur die Beschriftungen: Die Werte selbst bleiben oben auf `nowrap`, damit
     „10:00 Uhr" und „47 €" nicht auseinandergerissen werden. */
  @media (max-width: 34rem) {
    .table th,
    .table td {
      padding-right: 0.4rem;
    }

    /* Nur die Spaltenköpfe werden getrennt: „Meldegebühr" ist ein Wort und
       ginge sonst nicht unter 105 px. `hyphenate-limit-chars` hält kurze
       Wörter davon fern — ohne die Regel trennt der Browser auch „Run-den",
       was mehr stört als es hilft. Browser ohne Unterstützung dafür trennen
       etwas großzügiger; kaputt ist dort nichts. */
    .table thead th {
      white-space: normal;
      overflow-wrap: break-word;
      -webkit-hyphens: auto;
      hyphens: auto;
      hyphenate-limit-chars: 10 4 4;
      /* Die Sperrung der Versalien kostet hier gut vier Pixel, die der
         Streckenspalte fehlen. Auf Lesbarkeit wirkt sich das bei fünf bis
         sieben Zeichen nicht aus. */
      letter-spacing: 0.02em;
    }

    /* Die Streckenbezeichnung bricht dagegen nur an ihrem Leerzeichen —
       „2 km" über „Flossenschwimmen", so wie es auch in der Ausschreibung
       steht. Ein getrenntes „Flossen-schwimmen" wäre drei Zeilen hoch und
       läse sich wie ein anderer Wettbewerb. */
    .table tbody th {
      /* Gleitend statt in Stufen: „Flossenschwimmen" ist das breiteste
         unteilbare Wort der Tabelle und bestimmt allein, ab wann sie nicht
         mehr passt. Mit clamp schrumpft die Beschriftung genau so weit mit,
         wie das Gerät schmaler wird — 16 px auf dem großen Telefon, 14 px als
         Untergrenze. Eine feste Stufe hätte entweder auf 390 px Platz
         verschenkt oder auf 360 px nicht gereicht. */
      font-size: clamp(0.875rem, 0.35rem + 2.4vw, 1rem);
      -webkit-hyphens: manual;
      hyphens: manual;
    }
  }
</style>
